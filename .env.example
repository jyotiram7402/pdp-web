# Copy to .env.local and adjust. Every variable is optional.

# Public URL of the site (used for canonical URLs, sitemap and structured data).
# On Vercel the production URL is detected automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quote requests: by default the quote form opens a pre-filled e-mail to this address.
NEXT_PUBLIC_QUOTE_EMAIL=sales@example.com

# Optional: POST quote requests as JSON to an endpoint (Formspree, CRM webhook, Power Automate, ...).
# When set, it is used instead of e-mail.
NEXT_PUBLIC_QUOTE_ENDPOINT=

# Optional: external checkout URL. When empty, the cart offers "Request a quote" instead.
NEXT_PUBLIC_CHECKOUT_URL=

# Image optimization: defaults to "true" on Vercel and "false" elsewhere.
# NEXT_IMAGE_OPTIMIZATION=true

# Extra image hosts allowed for optimization, comma separated (e.g. your inRiver/DAM CDN).
# IMAGE_REMOTE_HOSTS=assets.example.com,cdn.example.com
